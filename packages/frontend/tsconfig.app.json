{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true,

    // No baseUrl: deprecated in TS 6, removed in 7. Since TS 5.0 `paths` is
    // resolved relative to this file.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // .storybook lives outside src but is browser-side TypeScript that needs the
  // DOM lib and vite/client's CSS module declarations, so it belongs to this
  // project rather than tsconfig.node.json.
  "include": ["src", ".storybook"]
}
