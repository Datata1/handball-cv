# Data directory (large files, not committed). Anchored with a leading slash:
# unanchored, it also swallows source directories named `data` anywhere in the
# tree, e.g. packages/frontend/src/shared/ui/data/.
/data/*.duckdb
/data/models/

# Scripts logs
scripts/*.log

# Claude Code local settings (machine-specific, not for other devs)
.claude/settings.local.json

